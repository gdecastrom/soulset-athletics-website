# Copy to .env.local for `npm run dev`. In Vercel → Project → Settings → Environment Variables, set each one for the
# right environment: Production and Preview get different databases and different secrets (README → Deploy on Vercel).

# Postgres (Neon, Railway, …). The site connects as the restricted soulset_app login (created by the migrations).
DATABASE_URL=postgres://soulset_app:password@host/db?sslmode=require
# Only DATABASE_URL is read at runtime, never POSTGRES_URL (Vercel's Neon integration sets that one to the owner).
# The owner login, used only before each build to run migrations and sync the catalogue (scripts/release.ts).
# Production builds, and local `npm run build` / `npm run db:release`:
MIGRATION_DATABASE_URL=postgres://owner:password@host/db?sslmode=require
# Vercel preview builds use only this one: the owner login of a Neon branch, never production.
PREVIEW_MIGRATION_DATABASE_URL=

# Long random string: signs unsubscribe links and test payments, and salts stored IP hashes. Generate with: openssl rand -base64 32
# Use a different one per environment.
APP_SECRET=

# Resend (https://resend.com/api-keys). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Soulset Athletics <hola@soulsetathletics.com>
EMAIL_REPLY_TO=hola@soulsetathletics.com

# Optional: comma-separated addresses that get a short notice for every new sign-up.
NOTIFY_EMAIL=

# Public site URL (canonical links, sitemap, social previews, email links). In production it defaults to the Vercel
# production domain; previews and local runs use their own address. Production: https://web.soulsetathletics.com
# (soulsetathletics.com itself only shows the coming-soon cover; see docs/guia-de-desarrollo.md → Dominios).
SITE_URL=

# Payments (off until launch). See README → Payments.
CHECKOUT_ENABLED=false
# azul | cardnet | test (test is refused in production)
PAYMENT_PROVIDER=test
# Flat standard shipping in USD below the US$75 free-shipping threshold, e.g. 5
SHIPPING_FEE_USD=
# Origin of the gateway's hosted payment page, e.g. https://pagos.example.com (space-separated if several).
PAYMENT_FORM_ORIGINS=
