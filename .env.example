# Copy to .env.local for `vercel dev`; set the same values in Vercel → Project → Settings → Environment Variables.

# Postgres (Neon, Railway, …). The Neon integration on Vercel sets this one for you.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Long random string: signs unsubscribe links and test payments, and salts stored IP hashes. Generate with: openssl rand -base64 32
APP_SECRET=

# Resend (https://resend.com/api-keys). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Soulset Athletics <hola@soulsetathletics.com>
EMAIL_REPLY_TO=hola@soulsetathletics.com

# Optional: comma-separated addresses that get a short notice for every new sign-up.
NOTIFY_EMAIL=

# Optional: public site URL used in email links. Defaults to the Vercel production domain.
SITE_URL=

# Payments (off until launch). See README → Payments.
CHECKOUT_ENABLED=false
# azul | cardnet | test (test is refused in production)
PAYMENT_PROVIDER=test
# Flat standard shipping in USD below the US$75 free-shipping threshold, e.g. 5
SHIPPING_FEE_USD=
